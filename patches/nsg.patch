+void IndexNSG::SearchWithOptGraph(const float *query, size_t K,
+                                  const Parameters &parameters,
+                                  const std::vector<std::pair<unsigned, float>>& entry_points,
+                                  unsigned *indices) {
+  unsigned L = parameters.Get<unsigned>("L_search");
+  if (L < K) {
+    L = (unsigned)K;
+  }
+
+  unsigned long long local_dist_cnt = 0;
+  DistanceFastL2 *dist_fast = (DistanceFastL2 *)distance_;
+
+  std::vector<Neighbor> retset(L + 1);
+  std::vector<unsigned> init_ids;
+  init_ids.reserve(L);
+
+  boost::dynamic_bitset<> flags{nd_, 0};
+
+   
+  for (const auto& ep_pair : entry_points) {
+    unsigned ep_id = ep_pair.first;
+    if (ep_id >= nd_) continue;
+
+     
+    if (!flags[ep_id] && init_ids.size() < L) {
+      init_ids.push_back(ep_id);
+      flags[ep_id] = true;
+    }
+
+     
+    unsigned *ep_neighbors = (unsigned *)(opt_graph_ + node_size * ep_id + data_len);
+    unsigned MaxM_ep = *ep_neighbors;
+    ep_neighbors++;
+
+    for (unsigned i = 0; i < MaxM_ep && init_ids.size() < L; i++) {
+      unsigned neighbor_id = ep_neighbors[i];
+      if (neighbor_id < nd_ && !flags[neighbor_id]) {
+        init_ids.push_back(neighbor_id);
+        flags[neighbor_id] = true;
+      }
+    }
+  }
+
+   
+  while (init_ids.size() < L) {
+    unsigned id = rand() % nd_;
+    if (flags[id]) continue;
+    flags[id] = true;
+    init_ids.push_back(id);
+  }
+
+   
+  unsigned tmp_l = init_ids.size();
+  for (unsigned i = 0; i < tmp_l; i++) {
+    _mm_prefetch(opt_graph_ + node_size * init_ids[i], _MM_HINT_T0);
+  }
+
+   
+  unsigned actual_L = 0;
+  for (unsigned i = 0; i < tmp_l; i++) {
+    unsigned id = init_ids[i];
+    float *x = (float *)(opt_graph_ + node_size * id);
+    float norm_x = *x;
+    x++;
+    float dist = dist_fast->compare(x, query, norm_x, (unsigned)dimension_);
+    local_dist_cnt++;
+    retset[actual_L] = Neighbor(id, dist, true);
+    actual_L++;
+  }
+
+  std::sort(retset.begin(), retset.begin() + actual_L);
+
+   
+  int k = 0;
+  while (k < (int)actual_L) {
+    int nk = actual_L;
+
+    if (retset[k].flag) {
+      retset[k].flag = false;
+      unsigned n = retset[k].id;
+
+       
+      if (k + 1 < (int)actual_L && retset[k + 1].flag) {
+        unsigned next_id = retset[k + 1].id;
+        _mm_prefetch(opt_graph_ + node_size * next_id, _MM_HINT_T0);
+        _mm_prefetch(opt_graph_ + node_size * next_id + data_len, _MM_HINT_T0);
+      }
+
+       
+      char* neighbor_base = opt_graph_ + node_size * n + data_len;
+      unsigned *neighbors = (unsigned *)neighbor_base;
+      unsigned MaxM = *neighbors;
+      neighbors++;
+
+       
+      constexpr unsigned PREFETCH_DISTANCE = 3;
+
+      for (unsigned m = 0; m < MaxM; ++m) {
+        if (m + PREFETCH_DISTANCE < MaxM) {
+          unsigned p_id = neighbors[m + PREFETCH_DISTANCE];
+          _mm_prefetch(opt_graph_ + node_size * p_id, _MM_HINT_T1);
+        }
+
+        unsigned id = neighbors[m];
+        if (flags[id]) continue;
+        flags[id] = 1;
+
+        float *data = (float *)(opt_graph_ + node_size * id);
+        float norm = *data;
+        data++;
+
+        float dist = dist_fast->compare(query, data, norm, (unsigned)dimension_);
+        local_dist_cnt++;
+
+        if (dist >= retset[actual_L - 1].distance) continue;
+        Neighbor nn(id, dist, true);
+        int r = InsertIntoPool(retset.data(), actual_L, nn);
+
+        if (r < nk) nk = r;
+      }
+    }
+    if (nk <= k) k = nk;
+    else ++k;
+  }
+
+  distance_computation_counter += local_dist_cnt;
+  for (size_t i = 0; i < K; i++) indices[i] = retset[i].id;
 }
 
